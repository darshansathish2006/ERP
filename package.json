{
  "name": "titans-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Titans Windows ERP - quotation management system for uPVC windows (EvA ERP replica)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc -p client/tsconfig.json --noEmit && vite build --config client/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "clear-data": "node --disable-warning=ExperimentalWarning server/seed.js --clear-data",
    "reset": "node --disable-warning=ExperimentalWarning server/seed.js --clean",
    "typecheck": "tsc -p client/tsconfig.json --noEmit",
    "test:engine": "node --disable-warning=ExperimentalWarning server/engine/selftest.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.51.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
